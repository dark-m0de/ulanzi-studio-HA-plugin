# --- Spec Kit -------------------------------------------------------------------
# Scaffolding generated by `specify init` is not versioned; regenerate it with
# `specify init --here --ai claude`. Only project-authored files are tracked:
#   .specify/memory/constitution.md  (project constitution)
#   specs/                           (feature specs, plans, tasks)
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md

# Spec Kit agent commands/skills for Claude Code
.claude/skills/speckit-*/

# --- Claude Code -----------------------------------------------------------------
.claude/settings.local.json

# --- Node.js ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.npm/

# --- Build output ----------------------------------------------------------------
dist/
build/
*.ulanziPlugin.zip

# --- Logs & environment ----------------------------------------------------------
*.log
.env
.env.*
!.env.example

# --- OS / editor -----------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
