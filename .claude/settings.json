{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git describe*)",
      "Bash(git remote -v)",
      "Bash(git remote show*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch --show-current)",
      "Bash(git tag)",
      "Bash(git tag --list*)",
      "Bash(git tag -l*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)",
      "Bash(git push origin *)",

      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh release download*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git push * :*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git restore*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *-f *)",
      "Bash(git switch *--force*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -M*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git tag -f*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc --prune*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git commit *--amend*)",
      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(git remote set-url*)",

      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh release delete*)",
      "Bash(gh release delete-asset*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue close*)",
      "Bash(gh run delete*)",
      "Bash(gh run cancel*)",
      "Bash(gh cache delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh label delete*)",
      "Bash(gh ruleset*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)"
    ]
  }
}
